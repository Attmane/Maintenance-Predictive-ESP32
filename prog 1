void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    Blynk.run();
  }

  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  // 1. Calcul de la magnitude brute
  float brute = sqrt(pow(a.acceleration.x, 2) + pow(a.acceleration.y, 2) + pow(a.acceleration.z, 2));

  // 2. Filtrage de la gravité (On veut 0 quand ça ne bouge pas)
  // On utilise abs() pour avoir une valeur positive de vibration
  float vibrationNette = abs(brute - 9.81); 

  // 3. Petit filtre pour ignorer le bruit électronique (en dessous de 0.5, on affiche 0)
  if (vibrationNette < 0.5) vibrationNette = 0;
  // --- LOGIQUE DE LA LED ---
  if (vibrationNette > seuilCritique) {
    //digitalWrite(pinLED, HIGH); // Allume la LED
    led_stat=255;
    Blynk.logEvent("alerte_machine", "Vibration critique détectée !");
  } else {
    //digitalWrite(pinLED, LOW);  // Éteint la LED si tout va bien
    led_stat=0;
  }

  // 4. Envoi à Blynk toutes les 500ms pour une fluidité parfaite
  static unsigned long lastMillis = 0;
  if (millis() - lastMillis > 500) {
    if (Blynk.connected()) {
       Blynk.virtualWrite(V1, vibrationNette); // Envoi sur le Pin Virtuel V1
       delay(100);
       Blynk.virtualWrite(V2, led_stat);
    }
    lastMillis = millis();
  }
}
